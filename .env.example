# Resend Configuration for Contact Form
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
# Must be from a verified domain in Resend (e.g. contact@evanreilly.me)
RESEND_FROM=contact@evanreilly.me
# Where contact form notifications should be sent
RESEND_TO=your@email.com

# Public site URL (used in confirmation email CTA)
SITE_URL=https://evanreilly.me

# GitHub API (for fetching pinned projects)
GITHUB_TOKEN=your_github_personal_access_token_here

# Application Configuration
NODE_ENV=development
PORT=5000
